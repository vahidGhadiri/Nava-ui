#!/bin/bash

GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
NC='\033[0m'

HAS_ERROR=0

echo "${BLUE}Running pre-commit checks...${NC}" >&2
echo "" >&2

echo "${YELLOW}→ Linting...${NC}" >&2
pnpm lint:fix > /dev/null 2>&1
if [ $? -ne 0 ]; then
  echo "${RED}✖ Lint fix failed${NC}" >&2
  HAS_ERROR=1
else
  echo "${GREEN}✔ Lint fixed${NC}" >&2
fi

echo "${YELLOW}→ Checking lint...${NC}" >&2
pnpm lint:check > /dev/null 2>&1
if [ $? -ne 0 ]; then
  echo "${RED}✖ Lint check failed${NC}" >&2
  HAS_ERROR=1
else
  echo "${GREEN}✔ Lint passed${NC}" >&2
fi

echo "${YELLOW}→ Formatting...${NC}" >&2
pnpm format > /dev/null 2>&1
if [ $? -ne 0 ]; then
  echo "${RED}✖ Format failed${NC}" >&2
  HAS_ERROR=1
else
  echo "${GREEN}✔ Formatted${NC}" >&2
fi

FILES=$(git diff --cached --name-only --diff-filter=ACM)

while IFS= read -r FILE; do
  CONTENT=$(git show ":$FILE" 2>/dev/null)

  if echo "$CONTENT" | grep -q "console\.log" && [[ "$FILE" != ".husky/"* ]]; then
    echo "${RED}✖ Found 'console.log' in '$FILE'. Remove it before committing.${NC}" >&2
    HAS_ERROR=1
  fi

  if [[ "$FILE" =~ \.ts$|\.tsx$ ]]; then
    if echo "$CONTENT" | grep -qE "@ts-ignore|@ts-nocheck"; then
      echo "${RED}✖ Found '@ts-ignore/@ts-nocheck' in '$FILE'. Remove it before committing.${NC}" >&2
      HAS_ERROR=1
    fi
  fi
done <<< "$FILES"

echo "" >&2

if [ "$HAS_ERROR" -eq 1 ]; then
  echo "${RED}Pre-commit hook failed. Please fix the above issues.${NC}" >&2
  exit 1
fi

echo "${GREEN}✔ All checks passed.${NC}" >&2
exit 0
